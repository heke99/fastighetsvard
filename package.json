{
  "name": "faddebo",
  "version": "1.0.0",
  "private": true,
  "description": "FaddeBo – fastighets-, uthyrnings- och hyresgästplattform för Östgöta El Teknik AB.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/lint.mjs && node scripts/verify-function-grants.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests",
    "test:integration": "vitest run tests/production-hardening.test.ts tests/supabase-schema.test.ts",
    "test:rls": "psql \"${SUPABASE_DB_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f supabase/tests/verify_rls.sql -f supabase/tests/verify_function_grants.sql",
    "test:concurrency": "node scripts/verify-concurrency-primitives.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "supabase:link": "supabase link",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db reset",
    "db:verify": "psql \"${SUPABASE_DB_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f supabase/tests/verify_schema.sql",
    "vercel-build": "next build",
    "ci": "npm run lint && npm run verify:accounts && npm run verify:login-dashboard && npm run verify:consistency && npm run typecheck && npm run test:unit && npm run build",
    "bootstrap:admin": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "bootstrap:owner": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "verify:auth": "node --env-file=.env.local scripts/verify-auth-config.mjs",
    "verify:accounts": "node scripts/verify-account-lifecycle.mjs",
    "verify:login-dashboard": "node scripts/verify-login-dashboard.mjs",
    "verify:consistency": "node scripts/verify-role-maintenance-consistency.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "next": "15.5.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": "22.16.0"
  },
  "packageManager": "npm@10.9.2"
}
